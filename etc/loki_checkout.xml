<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:LokiCheckout_Core:etc/loki_checkout.xsd">
    <grid_layouts>
        <grid_layout name="default_grid">
            <grid name="belgium" countryId="BE" parent="default">
                <block alias="postcode" mdColSpan="3"/>
                <block alias="city" mdColSpan="9"/>
                <block alias="street0" />
                <block alias="street1" mdColSpan="3"/>
                <block alias="street2" mdColSpan="3"/>
                <block alias="street3" />
                <block alias="region" />
                <block alias="country_id" mdColSpan="12"/>
            </grid>
        </grid_layout>
    </grid_layouts>
</config>
